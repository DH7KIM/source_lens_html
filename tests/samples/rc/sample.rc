// sample.rc - a small complete Windows resource script (Source Viewer sample).
// Shows: #include, LANGUAGE, MENU, ACCELERATORS, DIALOGEX, STRINGTABLE, VERSIONINFO,
// BEGIN/END blocks, line and block comments.
//
// Build (MinGW): windres -O coff sample.rc -o sample_res.o
#include <windows.h>
#include "resource.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

/* ---- Menu ---- */
IDR_MAINMENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Open...\tCtrl+O", ID_FILE_OPEN
        MENUITEM SEPARATOR
        MENUITEM "E&xit",            ID_FILE_EXIT
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About",           ID_HELP_ABOUT
    END
END

/* ---- Keyboard shortcuts ---- */
IDR_ACCEL ACCELERATORS
BEGIN
    "O", ID_FILE_OPEN, VIRTKEY, CONTROL
    VK_F1, ID_HELP_ABOUT, VIRTKEY
END

/* ---- About dialog ---- */
IDD_ABOUT DIALOGEX 0, 0, 190, 80
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About Sample"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Sample program", -1, 14, 14, 160, 8
    LTEXT           "Version 1.0.0", IDC_VERSION_TEXT, 14, 28, 160, 8
    DEFPUSHBUTTON   "OK", IDOK, 130, 56, 50, 14
END

STRINGTABLE
BEGIN
    IDS_APP_TITLE   "Sample"
    IDS_APP_READY   "Ready"
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Sample resource script"
            VALUE "FileVersion",     "1.0.0.0"
            VALUE "ProductName",     "Sample"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
