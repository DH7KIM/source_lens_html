// Source Lens language pack sample: only a few messages.
// Messages not listed here use the built-in translation (UI_MSG), then the English original.
{
  "ui-check": {
    // used: replaces the built-in translation
    "unknown attribute '{}'": "알 수 없는 속성 '{}' (언어팩)",
    // empty = not translated: the built-in translation is used
    "unknown element kind '{}'": "",
    // different number of {}: ignored, and the status line tells it in red
    "uppercase letter in '{}'": "대문자가 있습니다",
  },
}
