#ui 1  section=menu_test
row bar  left=0 right=0 top=0 height=40  padding=8 {
    menu_button view  text="View"  menu=view_menu  tooltip="View options"
    menu_button none  text="Empty"  menu=empty_menu  tooltip=""
}
menu view_menu {
    menu_item small  text="Small"  radio
    menu_item large  text="Large"  radio checked
    separator
    menu_item grid   text="Grid"  checkable checked
    menu_item rulers text="Rulers"  checkable
    menu zoom   text="Zoom" {
        menu_item z1  text="100%"  radio checked
        menu_item z2  text="200%"  radio
    }
}
menu empty_menu {
}
