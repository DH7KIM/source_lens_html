#ui 1  section=menu_test
row bar  left=0 right=0 top=0 height=40  padding=8 {
    dropdown view  text="View"  menu=view_menu  tip="View options"
    dropdown none  text="Empty"  menu=empty_menu  tip=""
}
menu view_menu {
    item small  text="Small"  radio
    item large  text="Large"  radio checked
    separator
    item grid   text="Grid"  check checked
    item rulers text="Rulers"  check
    menu zoom   text="Zoom" {
        item z1  text="100%"  radio checked
        item z2  text="200%"  radio
    }
}
menu empty_menu {
}
