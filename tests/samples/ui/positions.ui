#ui 1  section=find_dialog
// Find and replace dialog: positions inside a group (left/right/top/bottom, right_of/below, spacing)
// Try "Fit to pane" and change the window size: elements with left+right or top+bottom stretch.

label   find_label     text="Find"      left=12 top=14 width=60
edit    find_text      right_of=find_label  right=110  top=10  placeholder="Text to find"  tooltip="Text to find"
label   replace_label  text="Replace"   left=12 below=find_label spacing=14 width=60
edit    replace_text   right_of=replace_label  right=110  below=find_text  placeholder="New text"  tooltip="Text to put in its place"

// Buttons stick to the right edge
button  find_next      text="Find next"    right=12 top=10 width=90  tooltip="Find the next match"
button  replace_one    text="Replace"      right=12 below=find_next width=90  tooltip="Replace this match"
button  replace_all    text="Replace all"  right=12 below=replace_one width=90  tooltip="Replace every match"

// Options: a group with its own inner area (padding).
// spacing is shared by right_of and below, so the second line uses top= instead of below=
group   options  left=12 right=110 below=replace_text spacing=12 height=80 padding=8 {
    checkbox match_case   text="Match case"    left=0 top=0  tooltip="Upper and lower case must match"
    checkbox whole_word   text="Whole word"    right_of=match_case spacing=20 top=0  tooltip="Match whole words only"
    checkbox wrap         text="Wrap around"   left=0 top=26  checked  tooltip="Continue from the start"
    checkbox regex        text="Regular expression"  right_of=wrap spacing=20 top=26            disabled  tooltip="Use a regular expression"  disabled_tooltip="Not supported yet"
}

// Result area: all the space that is left
canvas  results  left=12 right=12 below=options spacing=12 bottom=40
label   status   text="0 matches"  left=12 bottom=12
button  close    text="Close"  right=12 bottom=8 width=90  tooltip="Close this dialog"
