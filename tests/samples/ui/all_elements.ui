#ui 1  section=tile_editor
// Tile editor main window: every element kind, defaults, hidden/disabled, menus (radio groups, checkable, submenus)
// View mode: click "File", "Format" and "View" to open the menus.
defaults button      height=26
defaults menu_button height=26
defaults row         spacing=4 padding=4

// Menu bar
row menubar  left=0 right=0 top=0 height=34 {
    menu_button file_btn    text="File"    menu=file_menu    tooltip="Open and save"
    menu_button format_btn  text="Format"  menu=format_menu  tooltip="Tile format"
    menu_button view_btn    text="View"    menu=view_menu    tooltip="What to show"
    spacer
    label    file_name   text="font.gba"  align=right
}

// Tool bar
row toolbar  left=0 right=0 below=menubar spacing=0 height=36 align=center {
    button       open     text="Open"   tooltip="Open a ROM file"
    button       save     text="Save"   disabled  tooltip="Save the ROM file"  disabled_tooltip="Nothing changed yet"
    button       undo     text="Undo"   hidden  tooltip="Undo"          // hidden still takes its space
    label        offset_l text="Offset"
    number_field offset   min=0 max=0x1FFFFFF step=0x10 hex width=100  tooltip="Start address of the tiles"
    text_field   search   width=120 max_length=64 placeholder="Find text"  tooltip="Text to find in the font"
    checkbox     grid     text="Grid"  checked  tooltip="Show the tile grid"
}

// Left: tile list, right: one tile larger, bottom: status line
canvas tiles   left=0 width=360 below=toolbar spacing=0 bottom=24
column side    right_of=tiles spacing=0 right=0 top=70 bottom=24 padding=8 {
    label  zoom_l   text="Selected tile"
    canvas zoom     height=160
    row    nav      align=center {
        button prev  text="◀"  width=40  tooltip="Previous tile"
        spacer
        label  index text="0 / 256"
        spacer
        button next  text="▶"  width=40  tooltip="Next tile"
    }
    spacer
}
label  status  text="Ready"  left=6 right=6 bottom=4

menu file_menu {
    menu_item open_item   text="Open..."
    menu_item save_item   text="Save"
    menu_item save_as     text="Save as..."
    separator
    menu recent      text="Recent files" {
        menu_item r1  text="font.gba"
        menu_item r2  text="title.gba"
    }
    separator
    menu_item quit        text="Quit"
}

menu format_menu {
    menu_item bpp1  text="1bpp"  radio checked     // one radio group
    menu_item bpp2  text="2bpp"  radio
    menu_item bpp4  text="4bpp"  radio
    separator                                // a separator starts a new radio group
    menu_item w8    text="8 × 8"    radio checked
    menu_item w16   text="16 × 16"  radio
    separator
    menu order text="Byte order" {
        menu_item little  text="Little endian"  radio checked
        menu_item big     text="Big endian"     radio
    }
}

menu view_menu {
    menu_item show_grid  text="Grid"      checkable checked
    menu_item show_addr  text="Address"   checkable
    separator
    menu zoom_menu  text="Zoom" {
        menu_item z1  text="100%"  radio checked
        menu_item z2  text="200%"  radio
        menu_item z4  text="400%"  radio
    }
}
